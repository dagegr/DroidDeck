    <string name="game_env_empty">未设置任何变量。将应用驱动与 Proton 的默认值。</string>
    <string name="game_env_inherited">继承</string>
    <string name="game_env_custom">自定义变量</string>
    <string name="game_env_defaults">D3D12 功能级别默认为 12_2，着色器模型默认为 6_9。两者均可针对每款游戏修改或移除。</string>
    <string name="game_env_error">无法加载或应用设置。请检查可用存储空间后重试。</string>
    <string name="game_env_invalid">请使用有效的变量名和不含 NUL 字符的值（最多 8192 个字符）。</string>
    <string name="game_env_unused">标准 Linux Proton 运行时不会使用此变量；它可能需要自定义组件。</string>
    <string name="game_env_loading">加载中…</string>
    <string name="game_env_overrides">此配置中的设置会覆盖共享设置及匹配的 Steam 启动选项变量。「移除」会取消设置该变量；「恢复」则使用其继承的值。</string>
    <string name="game_env_feature">D3D12 功能级别覆盖。12_2 会报告 DirectX 12 Ultimate 能力；不受支持的功能可能失败。留空以自动检测。</string>
    <string name="game_env_shader">D3D12 着色器模型覆盖。6_9 需要足够新的 VKD3D 及匹配的 GPU 功能。留空以自动检测。</string>
    <string name="game_env_cache">保持启用 Mesa 着色器缓存以减少重复编译。设为 false 即启用缓存。</string>
    <string name="game_env_cache_size">Mesa 着色器缓存的最大容量，例如 1G。缓存越大占用存储越多。</string>
    <string name="game_env_vkd3d_config">D3D12 的 VKD3D 选项。nodxr 会禁用光线追踪；仅在游戏需要时使用。</string>
    <string name="game_env_proton_log">设为 1 可生成 Proton 诊断日志。记录日志可能降低性能并占用存储。</string>
    <string name="game_env_wined3d">设为 1 可改用基于 OpenGL 的 WineD3D（而非 DXVK）进行 D3D9–11 兼容性测试。</string>
    <string name="game_env_xalia">设为 0 可为该游戏禁用 Proton 的手柄导航辅助功能。</string>
    <string name="game_env_hud">用于 D3D9–11 的 DXVK 叠加层。fps 显示帧率；取消设置则隐藏。</string>
    <string name="game_env_dxvk_config">以分号分隔的 DXVK 设置。较新的版本使用 dxvk.maxFrameRate 进行帧率限制；日常游玩建议使用会话帧率限制器。</string>
    <string name="game_env_vkd3d_limit">D3D12 帧率上限。0 表示不限制。</string>
    <string name="game_env_glthread">Mesa OpenGL 多线程。true 可改善受 CPU 限制的 OpenGL 游戏；请逐游戏测试。</string>
