    <string name="fex_performance_label">性能</string>
    <string name="fex_performance_detail">禁用全部 TSO；启用 multiblock。</string>
    <string name="fex_performance_tso_label">性能 + TSO</string>
    <string name="fex_performance_tso_detail">性能设置，并启用主 TSO。</string>
    <string name="fex_extreme_label">极限</string>
    <string name="fex_extreme_detail">禁用自修改代码检查。JIT 游戏和 DRM 可能失效。</string>
    <string name="fex_extreme_tso_label">极限 + TSO</string>
    <string name="fex_extreme_tso_detail">极限设置，并启用主 TSO。</string>
    <string name="fex_extreme_gn_label">极限-gn</string>
    <string name="fex_extreme_gn_detail">性能设置并启用 TSC 与元数据提示。建议在「极限」之前尝试。</string>
    <string name="fex_denuvo_label">Denuvo</string>
    <string name="fex_denuvo_detail">性能设置，启用完整代码检查并隐藏 hypervisor 位。</string>
