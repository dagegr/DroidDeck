<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">DroidDeck</string>
    <string-array name="loading_hints">
        <item>首次运行会下载 Steam，可能需要几分钟。</item>
        <item>默认情况下，离开应用会暂停 Steam；回来时会从上次中断处继续。</item>
        <item>你的手柄会识别为 Xbox 360 手柄；否则可使用屏幕触控操作。</item>
    </string-array>
    <string-array name="loading_hints_desktop">
        <item>首次运行会配置桌面环境，可能需要几分钟。</item>
        <item>默认情况下，离开应用会暂停会话；回来时会从上次中断处继续。</item>
        <item>触屏可当作触控板：拖动移动指针，轻点即点击。</item>
        <item>你的手柄会识别为 Xbox 360 手柄；否则可使用屏幕触控操作。</item>
    </string-array>
    <string name="session_channel">会话</string>
    <string name="session_channel_description">当 Steam 或桌面会话打开时显示</string>
    <string name="session_notification">Steam 正在运行</string>
    <string name="session_notification_paused">会话已暂停 - 准备好后点击「继续」</string>
    <string name="resume_session">继续</string>
